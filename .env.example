# n8n webhook that receives the step 1 and step 2 lead-capture POSTs (see src/lib/submitLead.ts).
# Leave empty here — fill in the real value in your local .env (gitignored).
VITE_N8N_WEBHOOK_URL=

# Optional auth header value if the n8n webhook requires one (e.g. a bearer token or shared secret).
# Sent as `Authorization: Bearer <value>` when set — adjust submitLead.ts if n8n expects a different header/scheme.
VITE_N8N_WEBHOOK_AUTH=
